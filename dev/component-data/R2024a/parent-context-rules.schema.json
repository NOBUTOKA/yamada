{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yamada.dev/schemas/component-data/R2024a/parent-context-rules.schema.json",
  "title": "yamada R2024a parent-context audit rules",
  "description": "Development-only rules for deriving a child component's effective property surface from its direct-parent context.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "matlabRelease", "contexts", "rules"],
  "properties": {
    "$schema": {
      "const": "parent-context-rules.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "matlabRelease": {
      "const": "R2024a"
    },
    "contexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/context"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parentFactories"],
      "properties": {
        "id": {
          "enum": ["absolute", "grid", "structural"]
        },
        "parentFactories": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*$"
          },
          "uniqueItems": true
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contextId", "scope", "effect", "path"],
      "properties": {
        "contextId": {
          "enum": ["absolute", "grid", "structural"]
        },
        "scope": {
          "const": "eligibleDirectChild"
        },
        "effect": {
          "enum": ["contributed", "suppressed", "constrained"]
        },
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)?$"
        },
        "valueContract": {
          "$ref": "schema.json#/$defs/valueContract"
        },
        "affectsDisplay": {
          "type": "boolean"
        },
        "previewPolicy": {
          "enum": ["apply", "adapt", "skip", "notRendered"]
        },
        "requiredEditor": {
          "enum": ["none", "text", "logical", "onOff", "enum", "number", "numericVector", "numericMatrix", "color", "stringList", "asset", "url", "dateTime", "tableData", "componentReference", "structuredData"]
        },
        "disposition": {
          "$ref": "schema.json#/$defs/disposition"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "effect": {
                "const": "contributed"
              }
            }
          },
          "then": {
            "required": ["valueContract", "affectsDisplay", "previewPolicy", "requiredEditor", "disposition"]
          }
        }
      ]
    }
  }
}
