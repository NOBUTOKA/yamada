{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yamada.dev/schemas/component-data/R2024a/grouping-design-input.schema.json",
  "title": "yamada R2024a grouping design input",
  "description": "Human-reviewed design input for Steps 7 through 11. Generated grouping artifacts are not input to this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "matlabRelease", "profileDefinitions", "sharedSubsetDefinitions"],
  "properties": {
    "$schema": { "const": "grouping-design-input.schema.json" },
    "schemaVersion": { "const": 1 },
    "matlabRelease": { "const": "R2024a" },
    "profileDefinitions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    },
    "sharedSubsetDefinitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/sharedSubset" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "categoryOrder"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "categoryOrder": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        }
      }
    },
    "sharedSubset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "categoryId", "sourceVariantId", "propertyPaths", "memberVariantIds"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "categoryId": { "$ref": "#/$defs/identifier" },
        "sourceVariantId": { "$ref": "#/$defs/identifier" },
        "propertyPaths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "memberVariantIds": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        }
      }
    }
  }
}
