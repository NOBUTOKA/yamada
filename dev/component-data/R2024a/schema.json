{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matlabappclassdesigner.dev/schemas/component-data/R2024a/component.schema.json",
  "title": "MatlabAppClassDesigner R2024a component documentation transcript",
  "description": "Development-only transcript of public component properties from MathWorks documentation. It is not the runtime component catalog and it does not authorize editing or Safe Preview application.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "matlabRelease",
    "factory",
    "documentedTypes",
    "sources",
    "properties"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "matlabRelease": {
      "const": "R2024a"
    },
    "factory": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*$"
    },
    "documentedTypes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "url", "scope"],
        "properties": {
          "type": {
            "const": "mathworksDocumentation"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "scope": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "appliesTo"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)?$"
          },
          "appliesTo": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "documentationSection": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "documentedValues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "styleDetails": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "summary": {
                  "type": "string"
                },
                "documentedValues": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "documentedReadOnly": {
                  "type": "boolean"
                }
              }
            }
          },
          "documentedReadOnly": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
