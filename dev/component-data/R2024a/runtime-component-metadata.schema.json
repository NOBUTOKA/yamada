{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-component-metadata.schema.json",
  "title": "yamada runtime component metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "matlabRelease",
    "factories"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "matlabRelease": {
      "const": "R2024a"
    },
    "factories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "factory",
          "allowedParentFactories",
          "isRoot",
          "capabilities"
        ],
        "properties": {
          "factory": {
            "type": "string",
            "minLength": 1
          },
          "allowedParentFactories": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "isRoot": {
            "type": "boolean"
          },
          "capabilities": {
            "type": "object"
          }
        }
      }
    }
  }
}
