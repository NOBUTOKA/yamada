    {
      "path": "DisabledDates",
      "categoryId": "datepicker",
      "order": 5,
      "summary": "Disabled dates",
      "documentedDefault": "empty datetime array",
      "documentedAcceptedValues": [
        "m-by-1 datetime array"
      ],
      "valueContract": {
        "kind": "dateTime",
        "shape": "vector",
        "allowsEmpty": true,
        "constraints": [
          {
            "kind": "sortedAscending"
          }
        ],
        "matlabClasses": [
          "datetime"
        ],
        "orientation": "column",
        "allowsNaT": false
      },
      "affectsDisplay": true,
      "previewPolicy": "apply",
      "requiredEditor": "dateTime",
      "disposition": {
        "kind": "editable",
        "reasonCodes": []
      },
      "runtimeSetAccess": "public",
      "runtimeObservations": [
        "R2024a accepts row input and stores it as a column, sorts descending input, and removes duplicate dates; the normalized contract follows the documented m-by-1 sorted input.",
        "R2024a rejects nonempty DisabledDates values containing NaT and stores NaT(0) as an empty datetime array."
      ]
