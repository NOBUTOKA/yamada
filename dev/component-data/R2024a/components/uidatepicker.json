      "path": "Value",
      "categoryId": "datepicker",
      "order": 1,
      "summary": "Selected date",
      "documentedDefault": "NaT",
      "documentedAcceptedValues": [
        "datetime object"
      ],
      "valueContract": {
        "kind": "dateTime",
        "shape": "scalar",
        "allowsEmpty": false,
        "constraints": [
          {
            "kind": "withinLimitsOf",
            "property": "Limits"
          }
        ],
        "matlabClasses": [
          "datetime"
        ],
        "allowsNaT": true,
        "normalization": "dateOnly"
      },
      "affectsDisplay": true,
      "previewPolicy": "apply",
      "requiredEditor": "dateTime",
      "disposition": {
        "kind": "editable",
        "reasonCodes": []
      },
      "runtimeSetAccess": "public",
      "runtimeObservations": [
        "R2024a preserves only the date when assigned a datetime containing time information; assigning [] is rejected."
      ]
    },
