      "order": 3,
      "summary": "Selection limits",
      "documentedAcceptedValues": [
        "1-by-2 datetime array"
      ],
      "valueContract": {
        "kind": "dateTime",
        "shape": "fixedLengthVector",
        "allowsEmpty": false,
        "constraints": [
          {
            "kind": "strictlyIncreasing"
          }
        ],
        "matlabClasses": [
          "datetime"
        ],
        "fixedLength": 2,
        "orientation": "row",
        "allowsNaT": false
      },
      "affectsDisplay": true,
      "previewPolicy": "apply",
      "requiredEditor": "dateTime",
      "disposition": {
        "kind": "editable",
        "reasonCodes": []
      },
      "runtimeSetAccess": "public",
      "documentedDefault": "[datetime(0000,1,1) datetime(9999,12,31)]",
      "runtimeObservations": [
        "R2024a normalizes a two-element column input to a 1-by-2 row.",
        "R2024a accepts equal bounds although the R2024a documentation says the second value must be later; the normalized contract follows the documentation."
      ]
    },
